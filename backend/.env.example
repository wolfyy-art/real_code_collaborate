# Render Backend Environment Template
# Set these in the Render Dashboard under your Backend Web Service "Environment" tab:

NODE_ENV=production
# PORT is automatically injected by Render (do not hardcode)
FRONTEND_URL=https://codecollab-app-ev89.onrender.com
ALLOWED_ORIGINS=https://codecollab-app-ev89.onrender.com

# PostgreSQL Connection String from Render Managed PostgreSQL (Internal Database URL)
DATABASE_URL=postgresql://user:password@host/dbname

# JWT & Cookie Secrets (Generate 64-char random string)
JWT_SECRET=generate_a_random_64_character_string_for_jwt_secret
COOKIE_SECRET=generate_another_random_64_character_string_for_cookie
COOKIE_SECURE=true

# Code Execution (Judge0)
# Default is the free Judge0 CE endpoint:
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Optional Redis (Leave blank if running single-instance)
REDIS_URL=

